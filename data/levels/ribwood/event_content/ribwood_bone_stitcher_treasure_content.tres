[gd_resource type="Resource" script_class="TreasureEventContent" format=3]

[ext_resource type="Script" path="res://scripts/game/event/treasure/treasure_event_content.gd" id="content"]
[ext_resource type="Script" path="res://scripts/card/card_data.gd" id="card_data"]
[ext_resource type="Resource" path="res://data/levels/ribwood/cards/ribwood_bone_stitch_needle.tres" id="needle"]
[ext_resource type="Resource" path="res://data/levels/ribwood/cards/ribwood_old_chest_cloak.tres" id="cloak"]
